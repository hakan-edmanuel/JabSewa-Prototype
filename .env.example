[TEMPLATE]
# ============================================================================
# JabSewa — Environment Variables (TEMPLATE)
# ============================================================================
# CARA PAKAI (lokal):
#   1. Salin file ini:  cp .env.example .env.local
#      (Vite memuat .env.local otomatis; file itu TIDAK di-commit — sudah
#       ter-ignore lewat aturan `.env.local` di .gitignore)
#   2. Isi kedua nilai di bawah dari dashboard Supabase project Anda:
#      Dashboard → Project Settings → API:
#        - Project URL            → VITE_SUPABASE_URL
#        - Publishable/Anon key   → VITE_SUPABASE_ANON_KEY
#      Format URL: https://<project-ref>.supabase.co  (cukup origin —
#      aplikasi menormalkan trailing path seperti /rest/v1/ sendiri;
#      lihat src/lib/supabaseClient.js)
#   3. Restart dev server (env Vite dibaca saat proses start).
#
# KEDUA variabel di bawah PUBLIK-safe (anon/publishable key) — Vite
# menyematkannya ke bundle frontend. JANGAN pernah menaruh service_role key
# atau password database di file ini.
# ============================================================================

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-publishable-key>

# ----------------------------------------------------------------------------
# HANYA untuk tooling server-side tepercaya (script audit/migrasi lokal, mis.
# scripts/apply-migration.mjs, npm run verify:supabase) — diisi di .env.local
# atau shell lokal Anda, JANGAN dipakai di kode frontend dan JANGAN di-commit:
#
#   DATABASE_URL                 — connection string Postgres/pooler project Anda
#   SUPABASE_SERVICE_ROLE_KEY    — service_role key (melewati RLS; rahasia)
#
# Contoh format:
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# ----------------------------------------------------------------------------
